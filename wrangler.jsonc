// Cloudflare Workers static-assets deploy. Jekyll builds into _site via the
// build command set in the Cloudflare dashboard; `wrangler deploy` uploads it.
{
  "name": "peng-albert-github-io",
  "compatibility_date": "2026-11-18",
  "assets": {
    "directory": "./_site",
    "not_found_handling": "404-page"
  }
}
